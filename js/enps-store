import {initializeApp} from 'https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js';
import {getAuth,GoogleAuthProvider,signInWithPopup,signOut,onAuthStateChanged} from 'https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js';
import {getFirestore,collection,doc,onSnapshot,setDoc,deleteDoc,serverTimestamp} from 'https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js';
const cfg=window.EURONICS_ENPS_FIREBASE_CONFIG;
const admins=(window.EURONICS_ENPS_ADMINS||[]).map(x=>x.toLowerCase());
const $=id=>document.getElementById(id);
const signal=()=>window.dispatchEvent(new Event('euronics:enps-updated'));
const style=document.createElement('style');style.textContent=`
#enpsManageBtn{margin:6px 12px;padding:9px 12px;border:1px solid #147b8d;border-radius:8px;background:#e8f6f8;color:#116879;cursor:pointer;font-weight:700}
#enpsManageBtn[hidden]{display:none}
#enpsModal{display:none;position:fixed;inset:0;background:#0a233b99;z-index:99999;align-items:center;justify-content:center;padding:15px}
#enpsModal.open{display:flex}
#enpsModal .panel{width:min(700px,100%);max-height:90vh;overflow:auto;background:white;border-radius:14px;padding:22px;color:#21313b}
#enpsModal .fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
#enpsModal label{font-weight:650;font-size:13px}
#enpsModal input,#enpsModal select{display:block;width:100%;box-sizing:border-box;margin-top:6px;padding:9px;border:1px solid #ccd5d9;border-radius:7px}
#enpsModal button{padding:8px 11px;margin:5px;border:1px solid #b6c9d0;border-radius:7px;cursor:pointer;background:#f3f9fa}
#enpsModal .primary{background:#147b8d;color:white}
#enpsModal table{border-collapse:collapse;width:100%;font-size:13px}#enpsModal td,#enpsModal th{padding:8px;border-bottom:1px solid #ddd;text-align:left}
@media(max-width:520px){#enpsModal .fields{grid-template-columns:1fr}}
`;document.head.append(style);
const btn=document.createElement('button');btn.id='enpsManageBtn';btn.hidden=true;btn.textContent='Manage eNPS';
$('execTrendTitle')?.insertAdjacentElement('afterend',btn);
const modal=document.createElement('div');modal.id='enpsModal';modal.innerHTML=`<div class="panel" role="dialog" aria-modal="true" aria-label="eNPS data management">
<div style="display:flex;justify-content:space-between"><h2>eNPS Data Entry</h2><button id="enpsClose">Close</button></div>
<p id="enpsIdentity">Sign in with Euronics Google Workspace.</p><button id="enpsLogin" class="primary">Sign in with Google</button><button id="enpsLogout" hidden>Sign out</button>
<form id="enpsForm" hidden><div class="fields">
<label>Survey date<input type="date" id="enpsDate" min="2026-04-01" required></label>
<label>Category<select id="enpsSegment"><option value="sales">Sales</option><option value="nonsales">Non-Sales</option><option value="blue">Blue Collar</option></select></label>
<label>Promoters (9–10)<input type="number" id="enpsP" min="0" step="1" required></label>
<label>Passives (7–8)<input type="number" id="enpsA" min="0" step="1" required></label>
<label>Detractors (0–6)<input type="number" id="enpsD" min="0" step="1" required></label></div>
<p id="enpsPreview">eNPS: —</p><button class="primary" id="enpsSave">Save to shared database</button><button type="reset">Clear</button></form>
<p id="enpsStatus" role="status"></p><h3>Saved survey entries</h3><div style="overflow:auto"><table><thead><tr><th>Date</th><th>Category</th><th>Responses</th><th>eNPS</th><th>Manage</th></tr></thead><tbody id="enpsRows"></tbody></table></div></div>`;
document.body.append(modal);
let auth=null,db=null,user=null,records=[],unsubscribe=null;
const isAdmin=()=>!!user&&admins.includes((user.email||'').toLowerCase());
const message=s=>{$('enpsStatus').textContent=s;};
const report=s=>{window.EURONICS_ENPS_ERROR=s;message(s);signal();};
const score=r=>{const n=r.promoters+r.passives+r.detractors;return n?Math.round(100*(r.promoters-r.detractors)/n):null;};
function render(){
 $('enpsIdentity').textContent=user?`${user.email} · ${isAdmin()?'Admin':'Read only'}`:'Sign in with Euronics Google Workspace.';
 $('enpsLogin').hidden=!!user;$('enpsLogout').hidden=!user;$('enpsForm').hidden=!isAdmin();
 $('enpsRows').replaceChildren();
 for(const r of records.slice().sort((a,b)=>b.date.localeCompare(a.date))){
  const tr=$('enpsRows').insertRow();
  [r.date,{sales:'Sales',nonsales:'Non-Sales',blue:'Blue Collar'}[r.segment]||r.segment,String(r.promoters+r.passives+r.detractors),String(score(r)??'—')].forEach(t=>tr.insertCell().textContent=t);
  const cell=tr.insertCell();if(!isAdmin()){cell.textContent='Read only';continue;}
  const edit=document.createElement('button');edit.textContent='Edit';edit.onclick=()=>{ $('enpsDate').value=r.date;$('enpsSegment').value=r.segment;$('enpsP').value=r.promoters;$('enpsA').value=r.passives;$('enpsD').value=r.detractors;preview();};cell.append(edit);
  const del=document.createElement('button');del.textContent='Delete';del.onclick=async()=>{if(!confirm('Delete this survey?'))return;try{await deleteDoc(doc(db,'enpsSurveys',r.id));}catch(e){report(e.message);}};cell.append(del);
 }
}
function preview(){const p=Number($('enpsP').value),a=Number($('enpsA').value),d=Number($('enpsD').value);$('enpsPreview').textContent='eNPS: '+(p+a+d?Math.round(100*(p-d)/(p+a+d)):'—');}
['enpsP','enpsA','enpsD'].forEach(id=>$(id).addEventListener('input',preview));
btn.onclick=()=>{modal.classList.add('open');render();};$('enpsClose').onclick=()=>modal.classList.remove('open');
modal.onclick=e=>{if(e.target===modal)modal.classList.remove('open');};
window.addEventListener('euronics:trend-open',e=>{btn.hidden=e.detail.key!=='enps';});
$('enpsLogin').onclick=async()=>{if(!auth)return report('Configure Firebase first.');try{const provider=new GoogleAuthProvider();provider.setCustomParameters({hd:'euronics.co.in'});await signInWithPopup(auth,provider);}catch(e){report(e.message);}};
$('enpsLogout').onclick=()=>auth&&signOut(auth);
$('enpsForm').onsubmit=async e=>{e.preventDefault();if(!isAdmin())return;
 const date=$('enpsDate').value,segment=$('enpsSegment').value,nums=['enpsP','enpsA','enpsD'].map(id=>Number($(id).value));
 if(date<'2026-04-01'||date>new Date().toISOString().slice(0,10)||!['sales','nonsales','blue'].includes(segment)||!nums.every(n=>Number.isSafeInteger(n)&&n>=0)||!nums.reduce((a,b)=>a+b,0))return report('Check date and response counts.');
 $('enpsSave').disabled=true;try{await setDoc(doc(db,'enpsSurveys',date+'_'+segment),{date,segment,promoters:nums[0],passives:nums[1],detractors:nums[2],updatedBy:user.email,updatedAt:serverTimestamp()});message('Saved successfully.');$('enpsForm').reset();preview();}catch(ex){report(ex.message);}finally{$('enpsSave').disabled=false;}
};
if(!cfg||cfg.apiKey==='REPLACE_ME'||cfg.projectId==='REPLACE_ME')report('Firebase setup required. See SETUP.md.');
else{
 const app=initializeApp(cfg,'euronics-enps');auth=getAuth(app);db=getFirestore(app);
 onAuthStateChanged(auth,account=>{user=account;unsubscribe?.();unsubscribe=null;records=[];window.EURONICS_ENPS_RECORDS=null;render();signal();
  if(!user)return report('Sign in to load shared eNPS.');
  if(!user.email?.toLowerCase().endsWith('@euronics.co.in'))return report('Euronics Workspace account required.');
  unsubscribe=onSnapshot(collection(db,'enpsSurveys'),snapshot=>{records=snapshot.docs.map(d=>({id:d.id,...d.data()}));window.EURONICS_ENPS_RECORDS=records;window.EURONICS_ENPS_ERROR='';message('');render();signal();},err=>report(err.message));
 });
}
